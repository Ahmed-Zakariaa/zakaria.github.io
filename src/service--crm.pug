extends include/layout
block header 
    +header('services')

block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                | CRM
            ul.breadcrumb
                li
                    a(href="index.html") home
                    span.breadcrumb-Separator /
                li
                    a(href="our-services.html")  Our Services
                    span.breadcrumb-Separator /
                li
                    span.active   CRM

                
        .main-content__body
            .services-inner-page 
                .content-list-wrapper 
                    .icon-wrapper 
                        img(src="/assets/images/crm.svg")
                    .content-item
                        p.content-item__desc
                            | Allows you to combine all customer related processes under one module for both inbound & outbound
                            | communication like (Lead Management, Lead Data Sync, Contact Creation, Document management, Data Import,
                            | Service Requests .. etc.)
                .content-photo
                    img(src="/assets/images/servicesDetails.png")
