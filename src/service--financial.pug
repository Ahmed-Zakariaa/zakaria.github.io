extends include/layout
block header 
    +header('services')

block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                | Financial
            ul.breadcrumb
                li
                    a(href="index.html") home
                    span.breadcrumb-Separator /
                li
                    a(href="our-services.html")  Our Services
                    span.breadcrumb-Separator /
                li
                    span.active   Financial

                
        .main-content__body
            .services-inner-page 
                .content-list-wrapper 
                    .icon-wrapper 
                        img(src="/assets/images/financial.svg")
                    .content-item
                        p.content-item__desc
                            | incorporates a sturdy financial module which allows you to perform basic and advanced financial operations
                            | like (Chart of Accounts, Fiscal Year, Customer Invoices, Expenses (accounts payable), Payments (accounts payable), Advance Payments (accounts payable), Collections (accounts receivable), General Journal, Cheque Management, Cheque Batch Receipt, PDC Factoring, Petty Cash Management, 
                            |Budgeting, Revenue recognition, Expense recognition, Fees recognition)
                .content-photo
                    img(src="/assets/images/servicesDetails.png")
