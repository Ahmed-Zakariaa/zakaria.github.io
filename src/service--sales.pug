extends include/layout
block header 
    +header('services')

block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                | Sales
            ul.breadcrumb
                li
                    a(href="index.html") home
                    span.breadcrumb-Separator /
                li
                    a(href="our-services.html")  Our Services
                    span.breadcrumb-Separator /
                li
                    span.active   Sales

                
        .main-content__body
            .services-inner-page 
                .content-list-wrapper 
                    .icon-wrapper 
                        img(src="/assets/images/Sales.svg")
