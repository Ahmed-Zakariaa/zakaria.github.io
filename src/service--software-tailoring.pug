extends include/layout
block header 
    +header('services')

block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                | Software Tailoring
            ul.breadcrumb
                li
                    a(href="index.html") home
                    span.breadcrumb-Separator /
                li
                    a(href="our-services.html")  Our Services
                    span.breadcrumb-Separator /
                li
                    span.active  Software Tailoring

                
        .main-content__body
            .services-inner-page 
                .content-list-wrapper 
                    .icon-wrapper 
                        img(src="/assets/images/software.svg")
                    .content-item
                        p.content-item__desc
                            | We don’t believe in offering ONLY generic solutions & products that look and work the same, but rather we do discuss all your needs
                            | and create a one-of-a-kind solution that blends - perfectly - with your brand.
                            | Using the right approach, our developers will leave no stone unturned to come up with a creative
                            | needed solution for your business and therefore, we create it to be a friendly user by your clients.
                            | In line with your company and end users’ needs, we design and build smooth and intuitive solutions that provide the highest expected user experience.
                .content-photo
                    img(src="/assets/images/servicesDetails.png")
