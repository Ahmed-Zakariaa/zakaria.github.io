extends include/layout

block header 
    +header('why')

block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                +_("لماذا Ctrl + M", "Why Ctrl+M")
            ul.breadcrumb
                li
                    a(href="index.html")
                        +_("الرئيسية", "Home")
                    span.breadcrumb-Separator /
                li
                    span.active
                        +_("لماذا Ctrl + M", "Why Ctrl+M")
        .main-content__body
