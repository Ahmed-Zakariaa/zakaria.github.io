extends include/layout
block header 
    +header('services')

block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                | Purchasing & Inventory Management
            ul.breadcrumb
                li
                    a(href="index.html") home
                    span.breadcrumb-Separator /
                li
                    a(href="our-services.html")  Our Services
                    span.breadcrumb-Separator /
                li
                    span.active   Purchasing & Inventory Management

                
        .main-content__body
            .services-inner-page 
                .content-list-wrapper 
                    .icon-wrapper 
                        img(src="/assets/images/inventory.svg")
                    .content-item
                        p.content-item__desc
                            | Provides a platform to raise purchase orders and track inventory while 
                            |also performing timely audit like (Purchase, Warehouse Management, Inventory Management, Inventory Receive,
                            | Inventory Issue, Inventory Transfer, Inventory Adjust & Inventory Return)
                .content-photo
                    img(src="/assets/images/servicesDetails.png")
