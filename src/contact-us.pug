extends include/layout
block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                +_("اتصل بنا", "Contact Us")
            ul.breadcrumb
                li
                    a(href="#")
                        +_("الرئيسية", "Home")
                    span.breadcrumb-Separator /
                li
                    a(href="#" class="active")  
                        +_("اتصل بنا", "Contact Us")
        .main-content__body
            .contact-us
                form.contact-us__form
                    input(type="text" placeholder='Name' )
                    input(type="email" placeholder='Email')
                    input(type="tel" placeholder='Phone number')
                    input(type="text" placeholder='Message subject')
                    textarea.contact-us__form__mssg(placeholder='Write A Message' rows='10')
                    a.button.button--blue(type="submit")
                        +_("أرسل رسالة", "Send Message")
                .contact-us__contact
                    a.contact-box(href="mailto:info@ctrlplusm.com")
                        span.contact-box__icon
                            svg(xmlns='http://www.w3.org/2000/svg' width='30' height='30' fill='none')
                                path(stroke='#083D5E' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M25 5H5a2.5 2.5 0 0 0-2.5 2.5v15A2.5 2.5 0 0 0 5 25h20a2.5 2.5 0 0 0 2.5-2.5v-15A2.5 2.5 0 0 0 25 5Z')
                                path(stroke='#083D5E' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m27.5 8.75-11.212 7.125a2.425 2.425 0 0 1-2.575 0L2.5 8.75')
                        span.contact-box__txt
                            +_("info@ctrlplusm.com", "info@ctrlplusm.com")
                    a.contact-box(href="tel:+4733378901")
                        span.contact-box__icon
                            svg(xmlns='http://www.w3.org/2000/svg' width='30' height='30' fill='none')
                                path(stroke='#083D5E' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M27.5 21.15v3.75a2.5 2.5 0 0 1-2.725 2.5 24.736 24.736 0 0 1-10.788-3.837 24.376 24.376 0 0 1-7.5-7.5A24.738 24.738 0 0 1 2.65 5.225 2.5 2.5 0 0 1 5.137 2.5h3.75a2.5 2.5 0 0 1 2.5 2.15c.159 1.2.452 2.378.875 3.512A2.5 2.5 0 0 1 11.7 10.8l-1.588 1.587a20 20 0 0 0 7.5 7.5L19.2 18.3a2.5 2.5 0 0 1 2.637-.563 16.05 16.05 0 0 0 3.513.876 2.5 2.5 0 0 1 2.15 2.537Z')
                        span.contact-box__txt 
                            +_("+458 123 657 2324", "+458 123 657 2324")
                    a.contact-box(href="")
                        span.contact-box__icon
                            svg(xmlns='http://www.w3.org/2000/svg' width='30' height='30' fill='none')
                                path(stroke='#083D5E' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M25 12.5c0 7.5-10 15-10 15S5 20 5 12.5a10 10 0 0 1 20 0Z')
                                path(stroke='#083D5E' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M15 16.25a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z')
                        span.contact-box__txt 
                            +_("En ontvang vrijblijvend 1217", "En ontvang vrijblijvend 1217")