extends include/layout
block header 
    +header('services')

block content
    .main-content-wrapper
        .main-content__header
            h2.main-content-title 
                | Usingo (Purchasing Platform)
            ul.breadcrumb
                li
                    a(href="index.html") home
                    span.breadcrumb-Separator /
                li
                    a(href="our-services.html")  Our Services
                    span.breadcrumb-Separator /
                li
                    span.active  Usingo (Purchasing Platform)

                
        .main-content__body
            .services-inner-page 
                .content-list-wrapper 
